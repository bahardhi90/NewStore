# Base URL of the Django API (must end with /api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Optional: separate media/CDN host if images are not served from the API host
NEXT_PUBLIC_MEDIA_URL=
# Public URL of this site (SEO, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true = use built-in mock data/API (no backend needed). false = call the real backend.
NEXT_PUBLIC_USE_MOCKS=true
# Optional: server-only API URL (e.g. http://web:8000/api inside Docker). Falls back to NEXT_PUBLIC_API_URL.
API_URL=
# Set to true only when running `npm start` locally against a backend on localhost (image optimization)
ALLOW_LOCAL_IMAGES=false
