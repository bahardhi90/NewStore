# Copy to .env on the server and fill in:  cp .env.example .env && nano .env
# Never commit the real .env.

# ---- Your domain (without www) and an email for the HTTPS certificate (Let's Encrypt)
DOMAIN=radawear.com
ACME_EMAIL=you@example.com

# ---- Only if nginx on this server already uses ports 80/443 (other websites): uncomment both.
# nginx then handles HTTPS and forwards to Caddy on 127.0.0.1:CADDY_HTTP_PORT. See README, "Server already runs nginx".
#COMPOSE_FILE=docker-compose.yml:docker-compose.behind-nginx.yml
#CADDY_HTTP_PORT=8080

# ---- Optional build proxy (for apt/pip/npm during "docker compose build")
#HTTP_PROXY=http://proxy.host:3128
#HTTPS_PROXY=http://proxy.host:3128
#NO_PROXY=localhost,127.0.0.1

# ---- Django: a long random secret. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# ---- Database. Use letters and digits only in the password (it goes into a URL).
POSTGRES_DB=store
POSTGRES_USER=store
POSTGRES_PASSWORD=

# ---- Payments are switched on/off in admin ("روش‌های پرداخت"). Keep this "zarinpal" in production:
# any value other than "fake" hides the test gateway, so nobody can "pay" without real money.
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=False

# ---- SMS (Melipayamak) is configured in admin: "تنظیمات پیامک". Nothing to set here.

# ---- Business rules
ORDER_PAYMENT_TIMEOUT_MINUTES=30
CART_MAX_QUANTITY=10

# ---- Optional
SENTRY_DSN=
LOG_LEVEL=INFO
USE_S3=False
