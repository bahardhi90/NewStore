# Copy to .env on the server and fill in:  cp .env.example .env && nano .env
# Never commit the real .env.

# ---- Your domain (without www) and an email for the HTTPS certificate (Let's Encrypt)
DOMAIN=radawear.com
ACME_EMAIL=you@example.com

# ---- Django: a long random secret. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# ---- Database. Use letters and digits only in the password (it goes into a URL).
POSTGRES_DB=store
POSTGRES_USER=store
POSTGRES_PASSWORD=

# ---- Payments are switched on/off in admin ("روش‌های پرداخت"). Keep this "zarinpal" in production:
# any value other than "fake" hides the test gateway, so nobody can "pay" without real money.
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=False

# ---- SMS (Melipayamak) is configured in admin: "تنظیمات پیامک". Nothing to set here.

# ---- Business rules
ORDER_PAYMENT_TIMEOUT_MINUTES=30
CART_MAX_QUANTITY=10

# ---- Optional
SENTRY_DSN=
LOG_LEVEL=INFO
USE_S3=False
