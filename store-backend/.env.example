# ---- Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---- Frontend (CORS + payment callback)
FRONTEND_URL=http://localhost:3000

# ---- Database / Redis (docker compose service names: db, redis)
DATABASE_URL=postgres://store:store@localhost:5432/store
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ---- SMS (Melipayamak) is configured in admin: SMS > SMS settings

# ---- Payment. Methods are enabled in admin ("Payment methods"); no change is needed here for Digipay/SnappPay.
# PAYMENT_GATEWAY picks the active method on first install; the fake gateway is hidden unless this is "fake".
PAYMENT_GATEWAY=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
# PAYMENT_CALLBACK_URL defaults to ${FRONTEND_URL}/payment/result

# ---- Business rules
ORDER_PAYMENT_TIMEOUT_MINUTES=30
CART_MAX_QUANTITY=10

# ---- Media on S3-compatible storage (ArvanCloud, MinIO, AWS...)
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=

# ---- Behind Nginx set to 1 so client IPs (OTP rate limits) are read from X-Forwarded-For
NUM_PROXIES=0

# ---- Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# ---- Production only (docker-compose.prod.yml builds DATABASE_URL from these)
POSTGRES_DB=store
POSTGRES_USER=store
POSTGRES_PASSWORD=change-me
